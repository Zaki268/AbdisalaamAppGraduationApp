// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  vehicle_owner
  traveler
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String   @unique
  password   String
  role       UserRole
  name       String
  phone      String?
  image      String?
  isVerified Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resetCode        String?
  resetCodeExpires DateTime?
  totalEarnings    Float        @default(0)
  pendingBalance   Float        @default(0)
  paidOutBalance   Float        @default(0)
    lastPayoutDate   DateTime?
  paymentDetails   Json?       // { method: "bank", accountNumber: "...", etc }

  vehicles         Vehicle[]    @relation("UserVehicles")
  trips            Trip[]
  bookings         Booking[]    @relation("UserBookings")
  settlements      Settlement[] // This is the inverse relation

  // activityLog ActivityLog[]
}

model Vehicle {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  userId      String      @db.ObjectId
  plateNumber String      @unique
  model       String
  capacity    Int
  color       String?
  type        VehicleType
  isDeleted   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  owner       User        @relation(name: "UserVehicles", fields: [userId], references: [id])
}

enum VehicleType {
  Car
  Land_Cruiser
  BL
  Bus
  Truck
  Coaster
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED // Auto-cancelled by CRON after X mins
}

enum TripStatus {
  PENDING
  ONGOING
  COMPLETED
  CANCELLED
}

model Booking {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  tripId      String        @db.ObjectId
  userId      String        @db.ObjectId
    settlementId    String?      @db.ObjectId
  seatsBooked Int
  status      BookingStatus @default(PENDING)
  bookingTime DateTime      @default(now())
  confirmedAt DateTime? // For admin-approved time
  expiredAt   DateTime? // If expired via CRON
  cancelledAt DateTime? // If cancelled
  isDeleted   Boolean       @default(false)
  trip        Trip          @relation(fields: [tripId], references: [id])
  user        User          @relation(name: "UserBookings", fields: [userId], references: [id])
  settlement      Settlement?  @relation(fields: [settlementId], references: [id])
  // Payment details
  totalAmount   Float
  systemFee     Float
  ownerEarnings Float
  ownerPaidOut  Boolean   @default(false)
  paidOutAt     DateTime?

  payoutStatus    PayoutStatus @default(unpaid)


  paymentStatus   String  @default("pending")
  paymentMethod   String?
  transactionId   String?
  paymentVerified Boolean @default(false)

  // Embedded trip snapshot (denormalized for reporting)
  tripSnapshot Json?
  

  @@unique([userId, tripId])
}

enum PayoutStatus {
  unpaid     // Not yet included in any payout
  pending    // Included in requested payout but not processed
  paid       // Successfully paid out
  failed     // Payout failed for this booking
}

model Settlement {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  ownerId        String     @db.ObjectId
  amount         Float
  status         SettlementStatus @default(requested)
  periodFrom     DateTime
  periodTo       DateTime

  // Embedded booking references
  bookings       Json       // Array of { bookingId: String, amount: Float, tripId: String, bookedAt: DateTime }

  // Payment info
  paymentMethod  String
  reference      String     @unique
  transactionReference String?

  // Timeline
  requestedAt    DateTime   @default(now())
  processedAt    DateTime?
  completedAt    DateTime?

  // Metadata
  adminNotes     String?
  metadata       Json?      // { adminId: String, processor: String, etc }

  // Relations
  owner          User       @relation(fields: [ownerId], references: [id])
  bookingsRelation Booking[]  // This name can be whatever makes sense for your app

  // Timestamps
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

}

enum SettlementStatus {
  requested   // Owner has requested payout
  processing  // Admin is processing the request
  completed   // Payout successfully processed
  failed      // Payout failed
  cancelled   // Request was cancelled
}

model Trip {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  origin         String
  destination    String
  date           DateTime
  time           String
  price          Float
  totalSeats     Int
  availableSeats Int
  vehicleIds     String[]
  bookings       Booking[]
  isDeleted      Boolean    @default(false)
  status         TripStatus @default(PENDING)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // ✅ Add this 👇
  userId          String  @db.ObjectId
  user            User    @relation(fields: [userId], references: [id])
  // 👇 Embedded tourism features (optional)
  isTourism       Boolean @default(false)
  tourismFeatures Json?
}
